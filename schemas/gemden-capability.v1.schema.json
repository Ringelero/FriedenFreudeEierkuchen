{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemden.red/schemas/gemden-capability.v1.schema.json",
  "title": "GemDen Capability Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespaces", "non_escalation_rules", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "namespaces": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "kind", "source", "meaning"],
        "properties": {
          "prefix": { "type": "string", "minLength": 2 },
          "kind": {
            "enum": ["human_skill", "ai_operation", "module_permission"]
          },
          "source": { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "non_escalation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "ffe_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-RULE-[A-Z0-9-]+$" },
          "rule": { "type": "string", "minLength": 1 },
          "ffe_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(?:OP-)?[A-Z][0-9]{2}$" },
            "uniqueItems": true
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version", "title", "scope", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^module:[a-z0-9.*:-]+$" },
          "kind": { "const": "module_permission" },
          "version": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "scope": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pilot", "active", "deprecated"] },
          "ffe_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(?:OP-)?[A-Z][0-9]{2}$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
