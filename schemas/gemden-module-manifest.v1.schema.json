{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemden.red/schemas/gemden-module-manifest.v1.schema.json",
  "title": "GemDen Module Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "title", "description", "status", "renderer", "data_inputs", "capabilities", "editor", "ffe_refs"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pilot", "active", "deprecated"] },
        "renderer": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]+$" },
        "data_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "entity", "cardinality", "required"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "entity": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "cardinality": { "enum": ["one", "many"] },
              "required": { "type": "boolean" }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires", "optional", "emits"],
          "properties": {
            "requires": {
              "type": "array",
              "items": { "type": "string", "pattern": "^module:[a-z0-9.*:-]+$" },
              "uniqueItems": true
            },
            "optional": {
              "type": "array",
              "items": { "type": "string", "pattern": "^module:[a-z0-9.*:-]+$" },
              "uniqueItems": true
            },
            "emits": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+:[a-z][a-z0-9.-]+$" },
              "uniqueItems": true
            }
          }
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "category_title", "default_props", "default_appearance", "fields"],
          "properties": {
            "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "category_title": { "type": "string", "minLength": 1 },
            "default_props": { "type": "object" },
            "default_appearance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tone", "motion"],
              "properties": {
                "tone": { "enum": ["neutral", "ruby", "gold", "mint"] },
                "motion": { "enum": ["none", "fade", "rise", "float", "pulse"] }
              }
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "target", "label", "control"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "target": { "type": "string", "pattern": "^(props|appearance)\\.[a-z][a-z0-9_]*$" },
                  "label": { "type": "string", "minLength": 1 },
                  "control": { "enum": ["text", "textarea", "select", "link-list"] },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["label", "value"],
                      "properties": {
                        "label": { "type": "string", "minLength": 1 },
                        "value": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ffe_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(?:OP-)?[A-Z][0-9]{2}$" },
          "uniqueItems": true
        }
      }
    }
  }
}
