{
  "$schema": "../../../schemas/gemden-page-document.v1.schema.json",
  "schema_version": "1.0.0",
  "id": "PAGE-MEM-MEMBER",
  "subject": {
    "kind": "member",
    "id": "MEM-MEMBER"
  },
  "status": "pilot",
  "visibility": "public",
  "ffe_refs": [
    "K05",
    "W01",
    "F04",
    "K10",
    "T05",
    "T10"
  ],
  "capability_context": {
    "human_skill_refs": [],
    "ai_operation_refs": [
      "OP-K05",
      "OP-W01",
      "OP-F04",
      "OP-K10",
      "OP-T05",
      "OP-T10"
    ],
    "module_permission_grants": [
      "module:data.public.community.read",
      "module:navigation.internal",
      "module:ui.motion.decorative"
    ]
  },
  "data_sources": [
    {
      "id": "community",
      "type": "json",
      "url": "../community-v0.1.json",
      "classification": "public",
      "collections": [
        "members",
        "skills",
        "evidence",
        "projects"
      ]
    }
  ],
  "bindings": {
    "member": {
      "kind": "entity",
      "source": "community",
      "collection": "members",
      "id": "MEM-MEMBER"
    },
    "skills": {
      "kind": "related",
      "source": "community",
      "collection": "skills",
      "ids_from": {
        "binding": "member",
        "field": "skill_ids"
      }
    },
    "evidence": {
      "kind": "related",
      "source": "community",
      "collection": "evidence",
      "ids_from": {
        "binding": "member",
        "field": "evidence_ids"
      }
    },
    "projects": {
      "kind": "related",
      "source": "community",
      "collection": "projects",
      "ids_from": {
        "binding": "member",
        "field": "project_ids"
      }
    }
  },
  "theme": {
    "preset": "ruby",
    "tokens": {
      "accent": "#c90046",
      "accent_deep": "#8d0033",
      "surface": "#fffaf6",
      "radius": "30px"
    },
    "motion": "gentle"
  },
  "regions": [
    {
      "id": "main",
      "layout": "flow",
      "modules": [
        {
          "id": "member-hero",
          "type": "gemden.profile-hero",
          "version": 1,
          "bindings": {
            "member": "member"
          },
          "props": {
            "eyebrow": "Member profile",
            "visual": "ruby-gem",
            "visual_label": "Animated profile symbol",
            "breadcrumb": [
              {
                "label": "Community",
                "href": "/community/"
              },
              {
                "label": "Members"
              },
              {
                "label": "Member"
              }
            ]
          },
          "appearance": {
            "tone": "ruby",
            "motion": "rise"
          }
        },
        {
          "id": "member-skills",
          "type": "gemden.skill-grid",
          "version": 1,
          "bindings": {
            "skills": "skills"
          },
          "props": {
            "eyebrow": "Skills portfolio",
            "title": "What I can contribute.",
            "intro": "Skills apply in their respective contexts. They are not a global ranking or an automatic commitment to every commission.",
            "icons": {}
          },
          "appearance": {
            "tone": "neutral",
            "motion": "rise"
          }
        },
        {
          "id": "member-evidence",
          "type": "gemden.evidence-grid",
          "version": 1,
          "bindings": {
            "evidence": "evidence"
          },
          "props": {
            "eyebrow": "Evidence instead of vague claims",
            "title": "Where the experience comes from.",
            "boundary": "Evidence applies only in the described context and does not replace any required authorisation or specific safety assessment."
          },
          "appearance": {
            "tone": "gold",
            "motion": "fade"
          }
        },
        {
          "id": "member-projects",
          "type": "gemden.project-grid",
          "version": 1,
          "bindings": {
            "projects": "projects"
          },
          "props": {
            "eyebrow": "Published projects",
            "title": "What I'm working on.",
            "intro": "Projects show the described status and the person's own role. They are not an automatic commitment to new commissions."
          },
          "appearance": {
            "tone": "mint",
            "motion": "rise"
          }
        }
      ]
    }
  ]
}
